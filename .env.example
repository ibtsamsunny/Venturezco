# Copy this file to .env.local and fill in real values. See SETUP.md for
# the full walkthrough of each integration.

# Email notifications (contact form, booking confirmations) — Resend.
# Without RESEND_API_KEY, emails are logged to the server console instead
# of sent, so the site still works end-to-end with zero setup.
RESEND_API_KEY=re_...
NOTIFY_EMAIL=hello@venturezco.com
NOTIFY_FROM="VenturezCo <hello@venturezco.com>"

# Absolute production URL, used for links in transactional emails
# (footer link, etc). Falls back to https://venturezco.com if unset.
SITE_URL=https://venturezco.com

# Google Calendar (real booking availability + calendar event + Google Meet
# creation). Without these, the booking modal falls back to showing all
# business-hour slots as open and skips creating a calendar event.
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_CALENDAR_ID=primary
GOOGLE_BUSINESS_TIMEZONE=Europe/London
GOOGLE_REFRESH_TOKEN=...
